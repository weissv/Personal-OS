# =====================================================================
# MEZON SPRINT OS - PRODUCTION ENVIRONMENT CONFIGURATION
# =====================================================================

# 1. PostgreSQL Database URL
# In Coolify / Docker Compose, point to the container host name:
# e.g., postgresql://postgres:<password>@jkg2hjlwb9nntdjx43r6bcbo:5432/postgres?schema=public
DATABASE_URL="postgresql://postgres:password@postgres-db-host:5432/mezon_sprint_os?schema=public"

# 2. Authentication Secrets
# Generate a secure string: `openssl rand -base64 32`
JWT_SECRET="generate-a-secure-random-secret-key-for-jwt-signing"

# 3. Application Public Domain
# The public HTTPS URL where users access the app
NEXT_PUBLIC_APP_URL="https://sprint.mezon.uz"

# 4. S3 / Cloudflare R2 Media Storage
S3_BUCKET="mezon-sprint-media"
S3_ENDPOINT="https://r2.storage.school.mezon"
S3_REGION="auto"
S3_ACCESS_KEY_ID="your-r2-access-key-id"
S3_SECRET_ACCESS_KEY="your-r2-secret-access-key"
MEDIA_PUBLIC_URL="https://sprint.mezon.uz/api/v1/media/files"

# 5. Database Initialization
# Set to true on initial deploy to automatically seed sample students, mentor & parents
SEED_ON_START="true"
