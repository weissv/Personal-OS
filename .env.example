DATABASE_URL="postgresql://username@127.0.0.1:5433/mezon_sprint_os?schema=public"
# Секрет подписи сессий (≥16 символов). Сгенерируйте свой: openssl rand -hex 32
JWT_SECRET="change-me-to-a-random-64-char-hex-string"

# Первичный пароль администратора (используется только при создании аккаунта somi)
# ADMIN_INITIAL_PASSWORD=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# R2 / S3 Object Storage config
S3_BUCKET="mezon-sprint-media"
S3_ENDPOINT="https://r2.storage.school.mezon"
S3_REGION="auto"
S3_ACCESS_KEY_ID="your-r2-access-key"
S3_SECRET_ACCESS_KEY="your-r2-secret-key"
MEDIA_PUBLIC_URL="http://localhost:3000/api/v1/media/files"
